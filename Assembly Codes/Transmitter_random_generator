;==========================================================================
; TRANSMITTER (38KHz with XOR Encryption & Automated Random Numbers)
; ATmega328P @ 16MHz - 2400 Baud, 8N1
;==========================================================================
.include "m328pdef.inc"

; --- System and UART Configuration ---
.equ F_CPU      = 16000000          ; 16 MHz external crystal
.equ BAUD       = 2400              
.equ UBRR_VAL   = (F_CPU / (16 * BAUD)) - 1

; --- Encryption & Logic Configuration ---
.equ SECRET_KEY = 0x5A              ; The shared encryption key
.equ MAX_CHARS  = 20                ; Clear screen after 20 numbers

; --- Register Aliases ---
.def charsSent  = r23
.def lfsr_seed  = r24

.org 0x0000
    rjmp RESET                      

.org 0x0034
RESET:
    ; Initialize Stack Pointer 
    ldi   r16, high(RAMEND)
    out   SPH, r16
    ldi   r16, low(RAMEND)
    out   SPL, r16

    rcall USART_INIT
    ; rcall KEYPAD_INIT             ; <--- COMMENTED OUT (Keypad Broken)
    rcall CARRIER_INIT              ; START THE 38kHz BACKGROUND TIMER
    rcall ADC_INIT_SEED             ; Seed our random number generator
    
    clr   charsSent                 ; Reset character counter

    ; Send Startup String
    ldi   ZL, low(2 * MSG_READY)
    ldi   ZH, high(2 * MSG_READY)
    rcall USART_PRINT_STRING

;==========================================================================
; NEW AUTOMATED MAIN LOOP
;==========================================================================
MAIN_LOOP:
    ; 1. Generate random number 0-9
    rcall GET_RANDOM_0_9

    ; 2. Convert integer to ASCII ('0' to '9')
    subi  r16, -'0'

    ; 3. Send encrypted number via IR
    rcall USART_TRANSMIT_SECURE
    inc   charsSent

    ; 4. Check if we need to send a Newline to clear the Receiver screen
    cpi   charsSent, MAX_CHARS
    brsh  SCREEN_FULL

    ; 5. Wait 1 second and repeat
    rcall DELAY_1000MS
    rjmp  MAIN_LOOP

SCREEN_FULL:
    rcall DELAY_1000MS
    ldi   r16, 0x0A                 ; Line Feed (\n)
    rcall USART_TRANSMIT_SECURE     ; Encrypt and send newline
    clr   charsSent                 ; Reset counter
    rjmp  MAIN_LOOP

;==========================================================================
; RANDOM NUMBER GENERATOR (8-bit Galois LFSR)
;==========================================================================
GET_RANDOM_0_9:
    mov   r16, lfsr_seed
    lsr   r16                       
    brcc  SKIP_XOR                  
    ldi   r17, 0xB4                 
    eor   r16, r17                  
SKIP_XOR:
    mov   lfsr_seed, r16            

MODULO_LOOP:
    cpi   r16, 10
    brlo  MODULO_DONE               
    subi  r16, 10
    rjmp  MODULO_LOOP
MODULO_DONE:
    ret

;==========================================================================
; ADC STATIC NOISE SEEDING (Reads ADC0 / Physical Leg 23)
;==========================================================================
ADC_INIT_SEED:
    ldi   r16, (1<<REFS0)
    sts   ADMUX, r16
    ldi   r16, (1<<ADEN) | (1<<ADPS2) | (1<<ADPS1) | (1<<ADPS0)
    sts   ADCSRA, r16
    lds   r16, ADCSRA
    ori   r16, (1<<ADSC)
    sts   ADCSRA, r16
ADC_WAIT:
    lds   r16, ADCSRA
    sbrc  r16, ADSC
    rjmp  ADC_WAIT
    lds   r16, ADCL
    lds   r17, ADCH                 
    cpi   r16, 0
    brne  SEED_OK
    ldi   r16, 0x5A                 
SEED_OK:
    mov   lfsr_seed, r16            
    ret

;==========================================================================
; ENCRYPTION & UART SUBROUTINES
;==========================================================================
USART_TRANSMIT_SECURE:
    push  r17
    ldi   r17, SECRET_KEY           ; Load the secret key (0x5A)
    eor   r16, r17                  ; XOR ENCRYPT!
    rcall USART_TRANSMIT            
    eor   r16, r17                  ; Restore r16 just in case
    pop   r17
    ret

USART_INIT:
    ldi   r16, high(UBRR_VAL)
    sts   UBRR0H, r16
    ldi   r16, low(UBRR_VAL)
    sts   UBRR0L, r16
    ldi   r16, (1 << TXEN0)
    sts   UCSR0B, r16
    ldi   r16, (1 << UCSZ01) | (1 << UCSZ00)
    sts   UCSR0C, r16
    ret

USART_TRANSMIT:
    push  r17
USART_TX_WAIT:
    lds   r17, UCSR0A
    sbrs  r17, UDRE0                
    rjmp  USART_TX_WAIT
    sts   UDR0, r16                 
    pop   r17
    ret

USART_PRINT_STRING:
    push  r16
PRINT_LOOP:
    lpm   r16, Z+                   
    cpi   r16, 0                    
    breq  PRINT_DONE
    rcall USART_TRANSMIT_SECURE     
    rjmp  PRINT_LOOP
PRINT_DONE:
    pop   r16
    ret

;==========================================================================
; 38kHz CARRIER GENERATOR (Timer2 CTC Mode)
;==========================================================================
CARRIER_INIT:
    in    r16, DDRB
    ori   r16, (1<<3)               
    out   DDRB, r16
    ldi   r16, 210
    sts   OCR2A, r16
    ldi   r16, (1<<COM2A0) | (1<<WGM21)
    sts   TCCR2A, r16
    ldi   r16, (1<<CS20)
    sts   TCCR2B, r16
    ret

;==========================================================================
; TIMING DELAYS
;==========================================================================
DELAY_1000MS:
    push  r18
    ldi   r18, 4
D1000_LOOP:
    rcall DELAY_250MS
    dec   r18
    brne  D1000_LOOP
    pop   r18
    ret

DELAY_250MS:
    push  r20
    push  r21
    push  r22
    ldi   r20, 40
D250_1: ldi   r21, 250
D250_2: ldi   r22, 133
D250_3: dec   r22
        brne  D250_3
        dec   r21
        brne  D250_2
        dec   r20
        brne  D250_1
    pop   r22
    pop   r21
    pop   r20
    ret

;==========================================================================
; DATA & COMMENTED KEYPAD LOGIC
;==========================================================================
MSG_READY:
    .db "LiFi Ready", 0, 0

